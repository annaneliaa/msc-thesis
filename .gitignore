# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Logs
*.log

# Artifacts
artifacts/*
!artifacts/.gitkeep
!artifacts/*/.gitkeep
!artifacts/*/.csv

# Data
data/*
*.parquet
*.csv
*.zip
*.json
# ...except this project's own config JSON (scenarios.json,
# baseline_features.json, etc.) -- these are checked-in settings every
# machine running the code needs (e.g. via load_scenarios/load_base_features
# in configs/__init__.py), not generated data, and the blanket *.json rule
# above was silently excluding them from every machine but the one that
# created them.
!src/thesis/configs/*.json

# Pytest
.pytest_cache/

# Coverage
.coverage
htmlcov/

# Ruff / Black cache
.ruff_cache/

# Environment variables
.env

# Old code
archive

# Output
out
.png
.pdf
.npz

# Docker
.dockerignore

# ML Flow
!mlruns
mlruns/*

.claude/
summaries/